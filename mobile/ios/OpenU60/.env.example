# Copy to .env (git-ignored) and fill in. Never commit .env.

# Apple Developer Team ID (required for physical device builds; optional for Simulator)
# Find yours: Xcode > Settings > Accounts > select team > Team ID
DEVELOPMENT_TEAM=YOUR_TEAM_ID_HERE
TEAM_ID=YOUR_TEAM_ID_HERE

# Must be unique to your Apple account; the Live Activity extension appends .liveactivity
BUNDLE_ID_PREFIX=com.example.openu60
