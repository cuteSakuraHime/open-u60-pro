# Copy to tools/u60.env (git-ignored). Environment variables override these.

# Router LAN address and agent URL
U60_ROUTER_IP=192.168.0.1
U60_AGENT_URL=http://192.168.0.1:9090

# Optional: full path to adb if it is not on PATH
U60_ADB=

# Only number qmi_dial.py may call. Use a number you own or are authorized to call.
U60_TEST_NUMBER=

# auto | ip
U60_CALL_TYPE=auto

# Generated binaries, probe reports and recordings (git-ignored)
U60_WORK_DIR=
